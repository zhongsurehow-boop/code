# This is an example environment file.
# For local development, copy this to a file named `.env` and fill in the values.
# The `docker-compose.yml` file is configured to load this `.env` file.

# --- Database Configuration for Docker Compose ---
# These variables are used by the 'db' service in docker-compose.yml
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=crypto_data

# Data Source Name (DSN) for connecting the Streamlit app to the database container.
# Note that the host is 'db', which is the name of the database service in docker-compose.
DB_DSN="postgresql://user:password@db:5432/crypto_data"


# --- DEX Provider Configuration ---
# RPC URLs for connecting to different blockchains
RPC_URL_ETHEREUM="https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID"
RPC_URL_POLYGON="https://polygon-rpc.com/"


# --- CEX API Key Configuration (Optional) ---
# API keys can provide access to more detailed information or higher rate limits.
# Add keys for any exchange you want to use with authenticated endpoints.
BINANCE_API_KEY="your_binance_api_key"
BINANCE_API_SECRET="your_binance_api_secret"

# Add other exchange keys as needed
# KRAKEN_API_KEY="your_kraken_api_key"
# KRAKEN_API_SECRET="your_kraken_api_secret"
